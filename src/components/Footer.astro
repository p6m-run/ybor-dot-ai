---
// Site footer: brand column, link columns, newsletter, and legal bar.
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div>
        <div class="footer-mark"><img src="/assets/logos/Ybor.ai_mark_wte.svg" alt="Ybor"></div>
        <p class="footer-tagline">Production-grade platform engineering, for enterprises that ship.</p>
        <div class="footer-badges">
          <span class="logo-chip"><img src="/assets/logos/linux-foundation.png" alt="Linux Foundation"></span>
          <span class="logo-chip"><img src="/assets/logos/cncf.svg" alt="CNCF"></span>
        </div>
        <div class="footer-social">
          <a href="https://www.linkedin.com/company/ybor-technology-llc" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.34 9.5H5.67V18.5h2.67V9.5zM7 5.75a1.55 1.55 0 1 0 0 3.1 1.55 1.55 0 0 0 0-3.1zM18.33 18.5v-4.93c0-2.64-1.41-3.87-3.29-3.87-1.52 0-2.2.84-2.58 1.43V9.5h-2.67c.04.75 0 9 0 9h2.67v-5.02c0-.27.02-.54.1-.73.21-.54.7-1.1 1.53-1.1 1.08 0 1.51.82 1.51 2.02v4.83h2.67z"/></svg></a>
          {/* HIDDEN — this icon pointed at href="#" and went nowhere. Restore by
              uncommenting and replacing the href with the real Ybor GitHub org URL.
          <a href="#" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.91 0 1.38-.01 2.49-.01 2.83 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"/></svg></a>
          */}
        </div>
      </div>
      <div>
        <h4>Platform</h4>
        <div class="footer-links">
          <a href="/platform#infrastructure">Platform Infrastructure</a>
          <a href="/platform#delivery">Application Delivery</a>
          <a href="/how-it-works">How it Works</a>
          {/* HIDDEN — Pricing is parked for now. Restore by uncommenting.
          <a href="/pricing">Pricing</a>
          */}
          <a href="/platform#integrations">Integrations</a>
        </div>
      </div>
      <div>
        <h4>Company</h4>
        <div class="footer-links">
          <a href="/about">About</a>
          {/* HIDDEN — Customers is parked for now. Restore by uncommenting.
          <a href="/customers">Customers</a>
          */}
          <a href="/careers">Careers</a>
          <a href="/contact">Contact</a>
          <a href="/security">Security</a>
          <a href="/blog">Blog</a>
        </div>
      </div>
      <div>
        <h4>Resources</h4>
        <div class="footer-links">
          <a class="ext" href="https://developer.p6m.dev" target="_blank" rel="noopener">Developer Docs <i data-lucide="arrow-up-right" class="ext-arrow"></i></a>
          <a class="ext" href="https://platform.p6m.dev" target="_blank" rel="noopener">Platform Docs <i data-lucide="arrow-up-right" class="ext-arrow"></i></a>
          <a class="ext" href="https://platform.p6m.dev/status" target="_blank" rel="noopener">Platform Status <i data-lucide="arrow-up-right" class="ext-arrow"></i></a>
        </div>
        <form class="newsletter" data-newsletter style="margin-top:18px">
          <input class="input" type="email" placeholder="you@company.com" aria-label="Email for newsletter">
          <button class="btn btn-primary btn-sm" type="submit">Subscribe</button>
        </form>
      </div>
    </div>
    <div class="footer-bottom">
      <div>© 2024–{year} Ybor Technology LLC. All rights reserved.</div>
      <div class="footer-bottom-links">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/trust-center">Security Trust Center</a>
        <span>// soc 2 type ii</span>
      </div>
    </div>
  </div>
</footer>
