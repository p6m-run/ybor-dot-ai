---
// Primary site header: logo, desktop nav with dropdowns, and header CTAs.
// The theme-toggle button is injected into .header-inner by /js/site.js.
interface Props {
  /** Which top-level nav item to mark active for the current page. */
  active?: 'platform' | 'customers' | 'pricing' | 'security' | 'resources' | 'company';
}
const { active } = Astro.props;
const nav = (key: Props['active']) => `nav-link${active === key ? ' active' : ''}`;
---
<header class="header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="Ybor home"><img src="/assets/logos/Ybor.ai_mark_blk.svg" alt="Ybor"></a>
    <nav class="nav" aria-label="Primary">
      <div class="nav-item has-dd">
        <button class={nav('platform')} aria-haspopup="true">Platform <i data-lucide="chevron-down" class="chev"></i></button>
        <div class="dropdown" role="menu">
          <a class="dd-item" href="/platform" role="menuitem"><span class="dd-ic"><i data-lucide="layers"></i></span><span><span class="dd-title">Platform Overview</span><span class="dd-desc">One platform, from infrastructure to production.</span></span></a>
          <a class="dd-item" href="/platform#delivery" role="menuitem"><span class="dd-ic"><i data-lucide="rocket"></i></span><span><span class="dd-title">Delivery layer</span><span class="dd-desc">From commit to production in minutes.</span></span></a>
          <a class="dd-item" href="/platform#infrastructure" role="menuitem"><span class="dd-ic"><i data-lucide="server"></i></span><span><span class="dd-title">Foundation layer</span><span class="dd-desc">Production Kubernetes on every cloud, from one API.</span></span></a>
          <a class="dd-item" href="/how-it-works" role="menuitem"><span class="dd-ic"><i data-lucide="workflow"></i></span><span><span class="dd-title">How it Works</span><span class="dd-desc">The object model, operators, and addon catalog.</span></span></a>
        </div>
      </div>
      {/* HIDDEN — Customers and Pricing are parked for now. Restore by uncommenting;
          the pages live at src/pages/_customers.astro and _pricing.astro (drop the
          leading underscore to bring their routes back).
      <div class="nav-item"><a class={nav('customers')} href="/customers">Customers</a></div>
      <div class="nav-item"><a class={nav('pricing')} href="/pricing">Pricing</a></div>
      */}
      <div class="nav-item has-dd">
        <button class={nav('security')} aria-haspopup="true">Security <i data-lucide="chevron-down" class="chev"></i></button>
        <div class="dropdown" role="menu">
          <a class="dd-item" href="/security" role="menuitem"><span class="dd-ic"><i data-lucide="shield-check"></i></span><span><span class="dd-title">Security &amp; Compliance</span><span class="dd-desc">SOC 2, mTLS, policy enforcement, and the controls behind the platform.</span></span></a>
          <a class="dd-item" href="/trust-center" role="menuitem"><span class="dd-ic"><i data-lucide="badge-check"></i></span><span><span class="dd-title">Trust Center</span><span class="dd-desc">Download attestations and review continuously monitored controls.</span></span></a>
        </div>
      </div>
      <div class="nav-item has-dd">
        <button class={nav('resources')} aria-haspopup="true">Resources <i data-lucide="chevron-down" class="chev"></i></button>
        <div class="dropdown" role="menu">
          <a class="dd-item" href="https://developer.p6m.dev" target="_blank" rel="noopener" role="menuitem"><span class="dd-ic"><i data-lucide="book-open"></i></span><span><span class="dd-title">Developer Docs <i data-lucide="arrow-up-right" class="ext-arrow"></i></span><span class="dd-desc">REST, gRPC, GraphQL guides and the archetype catalog.</span></span></a>
          {/* HIDDEN — Blog pulled from the Resources menu. Restore by uncommenting;
              the /blog and /blog-crossplane pages are still live.
          <a class="dd-item" href="/blog" role="menuitem"><span class="dd-ic"><i data-lucide="file-text"></i></span><span><span class="dd-title">Blog</span><span class="dd-desc">Platform engineering patterns from the team.</span></span></a>
          */}
          <a class="dd-item" href="https://platform.p6m.dev/status" target="_blank" rel="noopener" role="menuitem"><span class="dd-ic"><i data-lucide="activity"></i></span><span><span class="dd-title">Platform Status <i data-lucide="arrow-up-right" class="ext-arrow"></i></span><span class="dd-desc">Live uptime and incident history.</span></span></a>
        </div>
      </div>
      <div class="nav-item has-dd">
        <button class={nav('company')} aria-haspopup="true">Company <i data-lucide="chevron-down" class="chev"></i></button>
        <div class="dropdown" role="menu">
          <a class="dd-item" href="/about" role="menuitem"><span class="dd-ic"><i data-lucide="building-2"></i></span><span><span class="dd-title">About</span><span class="dd-desc">Platform engineering, built by platform engineers.</span></span></a>
          <a class="dd-item" href="/careers" role="menuitem"><span class="dd-ic"><i data-lucide="users"></i></span><span><span class="dd-title">Careers</span><span class="dd-desc">Help build the platform layer for enterprise software.</span></span></a>
        </div>
      </div>
    </nav>
    <div class="header-cta">
      <a class="btn btn-secondary btn-sm" href="https://developer.p6m.dev" target="_blank" rel="noopener">View Docs <i data-lucide="arrow-up-right" class="ext-arrow"></i></a>
      <a class="btn btn-primary btn-sm" href="/contact?intent=demo">Contact Us</a>
    </div>
    <button class="hamburger" id="hamburger" aria-label="Open menu"><i data-lucide="menu"></i></button>
  </div>
</header>
