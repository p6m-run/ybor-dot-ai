---
import Base from '../layouts/Base.astro';
---
<Base title="Terms of Use — Ybor" description="The Terms of Use that govern access to and use of the Ybor.ai website and related mobile services.">
<style slot="head">
  .legal { max-width: 800px; margin: 0 auto; }
  .legal h2 { font-size: 22px; line-height: 1.2; letter-spacing: -0.02em; font-weight: 700; margin: 44px 0 12px; scroll-margin-top: 96px; }
  .legal h2 .h-slash { color: var(--purple); font-family: var(--font-mono); font-weight: 500; margin-right: 10px; }
  .legal h3 { font-size: 16px; font-weight: 700; margin: 26px 0 6px; }
  .legal p, .legal li { font-size: 16px; line-height: 1.7; color: var(--neutral-700); }
  .legal p + p { margin-top: 14px; }
  .legal ul { margin: 12px 0; display: flex; flex-direction: column; gap: 10px; }
  .legal ul li { display: flex; gap: 12px; }
  .legal ul li::before { content: ""; flex: none; width: 7px; height: 7px; margin-top: 11px; border-radius: 2px; background: var(--purple); transform: rotate(45deg); }
  .legal a.inline { color: var(--purple-dark); text-decoration: underline; text-underline-offset: 3px; word-break: break-word; }
  .legal code { font-family: var(--font-mono); font-size: 0.86em; background: var(--stroke-light); padding: 1px 6px; border-radius: 5px; }
  .legal .updated { font-family: var(--font-mono); font-size: 12.5px; color: var(--neutral-500); }

  /* Dark mode: these page-scoped rules use fixed light tokens (--neutral-700,
     --stroke-light, --purple-dark) that read poorly on the dark surface; Astro
     scoping raises their specificity above the global dark handling, so re-map
     them here. :global keeps the html[data-theme] ancestor unscoped. */
  :global([data-theme="dark"]) .legal p,
  :global([data-theme="dark"]) .legal li { color: var(--text-1); }
  :global([data-theme="dark"]) .legal a.inline { color: var(--purple-soft); }
  :global([data-theme="dark"]) .legal code { background: var(--surface-3); color: var(--text-0); }
  :global([data-theme="dark"]) .legal h2 .h-slash { color: var(--purple-soft); }
  :global([data-theme="dark"]) .legal .updated { color: var(--text-2); }
</style>

<section class="section bg-white">
  <div class="container">
    <div class="legal">
