<script slot="scripts" is:inline>
  (function(){
    var cards = document.querySelectorAll('.mc');
    if (!cards.length) return;
    if (!('IntersectionObserver' in window)) { cards.forEach(function(c){ c.classList.add('in'); }); return; }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.35 });
    cards.forEach(function(c){ io.observe(c); });
  })();

  // Hero fleet grid — counts up from 40 to 148 services, lighting cells as it goes.
  (function(){
    var grid = document.getElementById('fleetGrid');
    if (!grid) return;
    var cells = Array.prototype.slice.call(grid.querySelectorAll('.fleet-cell'));
    var countEl = document.getElementById('fleetCount');
    var healthyEl = document.getElementById('fleetHealthy');
    if (!cells.length) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    cells.forEach(function(c){ c.style.transition = 'opacity 320ms ease-out, transform 320ms ease-out'; });
    var TARGET = 148, START = 40, STEPS = 18;
    function litFor(v){ return Math.max(1, Math.round(v / TARGET * cells.length)); }
    function setState(v){
      var lit = (v >= TARGET) ? cells.length : litFor(v);
      cells.forEach(function(c, i){
        var on = i < lit;
        c.style.opacity = on ? '1' : '0';
        c.style.transform = on ? 'scale(1)' : 'scale(0.6)';
      });
      if (countEl) countEl.textContent = v;
      if (healthyEl) healthyEl.textContent = v + ' / ' + v;
    }
    if (reduce){ setState(TARGET); return; }
    setState(START);
    function grow(){
      var i = 0;
      var t = setInterval(function(){
        i++;
        var v = Math.round(START + (TARGET - START) * (i / STEPS));
        if (i >= STEPS) { v = TARGET; clearInterval(t); }
        setState(v);
      }, 90);
    }
    if ('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){ if (e.isIntersecting){ setTimeout(grow, 500); io.disconnect(); } });
      }, { threshold: 0.4 });
      io.observe(grid);
    } else { setTimeout(grow, 500); }
  })();

  // Hero headline verb — walks the SDLC once and rests on "shipping".
  (function(){
    var slot = document.querySelector('.verb-slot');
    if (!slot) return;
    var current = slot.querySelector('.verb');
    if (!current) return;
    // paint the resting word visibly regardless of motion preference
    current.style.transition = 'none';
    current.style.opacity = '1';
    current.style.transform = 'translateY(0)';
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches){
      current.textContent = 'shipping';
      return;
    }
    var seq = ['building','testing','securing','shipping'];
    var HOLD = 1600, FADE = 480, EASE = 'cubic-bezier(.22,.61,.36,1)', i = 0;
    var timers = [], running = false;
    var btn = document.getElementById('verbReplay');
    function clearTimers(){ timers.forEach(clearTimeout); timers = []; }
    function later(fn, ms){ var t = setTimeout(fn, ms); timers.push(t); return t; }
    function swap(word, done){
      var next = document.createElement('span');
      next.className = 'verb';
      next.setAttribute('data-verb','');
      next.textContent = word;
      next.style.transition = 'none';
      next.style.opacity = '0';
      next.style.transform = 'translateY(8px)';
      slot.appendChild(next);
      var prev = current;
      current = next;
      void next.offsetWidth; // commit initial state before transitioning
      var tr = 'opacity ' + FADE + 'ms ' + EASE + ', transform ' + FADE + 'ms ' + EASE;
      prev.style.transition = tr; prev.style.opacity = '0'; prev.style.transform = 'translateY(-8px)';
      next.style.transition = tr; next.style.opacity = '1'; next.style.transform = 'translateY(0)';
      later(function(){ if (prev && prev.parentNode) prev.parentNode.removeChild(prev); if (done) done(); }, FADE);
    }
    function step(){
      i++;
      if (i >= seq.length){ running = false; if (btn) btn.disabled = false; return; } // rest on 'shipping'
      swap(seq[i], function(){ later(step, HOLD - FADE); });
    }
    function play(){
      clearTimers();
      running = true; if (btn) btn.disabled = true;
      // reset the slot to a single 'building' node, then walk the SDLC
      slot.querySelectorAll('.verb').forEach(function(n){ if (n !== current) n.remove(); });
      current.textContent = 'building';
      current.style.transition = 'none';
      current.style.opacity = '1';
      current.style.transform = 'translateY(0)';
      i = 0;
      later(step, HOLD);
    }
    if (btn) btn.addEventListener('click', function(){ if (!running) play(); });
    // first paint is 'building'; walk the SDLC and rest on 'shipping'
    later(step, HOLD);
  })();
</script>
